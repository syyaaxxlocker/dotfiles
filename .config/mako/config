# ~/.config/mako/config
# Тёмно-зелёная тема Mako на основе твоей палитры waybar

font=Inter, Cantarell, sans-serif 11
markup=1
format=<b>%s</b>\n%b

layer=overlay
anchor=bottom-center
width=380
margin=12
padding=14
border-size=1
border-radius=14

icons=1
max-icon-size=48

default-timeout=5000
max-visible=5

background-color=#191B1AE6
text-color=#e0e2e1
border-color=#1a6e4d
progress-color=#1a6e4d

[urgency=low]
background-color=#191B1AD9
text-color=#d6d6d6
border-color=#3c3836
default-timeout=3500

[urgency=normal]
background-color=#191B1AEF
text-color=#e0e2e1
border-color=#1a6e4d

[urgency=critical]
background-color=#191B1AF7
text-color=#e0e2e1
border-color=#1a6e4d
border-size=2
default-timeout=0
